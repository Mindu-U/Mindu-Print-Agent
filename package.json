{
  "name": "mindu-print",
  "productName": "Mindu Print",
  "version": "0.3.1",
  "private": true,
  "description": "Mindu website-to-printer connection",
  "author": "Mindu Team",
  "main": "src/main/index.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource/noto-sans-georgian": "^5.2.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "agency.mindu.print",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "src/main/raw-print.ps1"
    ]
  }
}
